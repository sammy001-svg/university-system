# Never serve the environment file, whatever mod_rewrite is doing.
# Scoped to .env* / env.ini only -- a blanket dotfile deny would also block
# /.well-known/acme-challenge and break cPanel AutoSSL renewals.
<FilesMatch "^(\.env($|\.)|env\.ini$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Route all web traffic safely to /public without rewrite loops
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
