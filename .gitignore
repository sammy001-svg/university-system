/.env

# Keep the runtime directories in the repo, ignore whatever lands in them.
/storage/logs/*
/storage/cache/*
/storage/uploads/*
# Student records to import (personal data) never go into git.
/storage/imports/*
!/storage/uploads/avatars/
!/storage/uploads/documents/
/storage/uploads/avatars/*
/storage/uploads/documents/*
/public/uploads/*
!.gitkeep

.DS_Store
Thumbs.db
