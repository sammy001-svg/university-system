APP_NAME="Metropolitan University"
APP_SHORT_NAME="MU"
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Africa/Nairobi
APP_KEY=base64:CHANGE_THIS_TO_A_RANDOM_32_BYTE_STRING

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=university_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=ums_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@university.ac.ke
MAIL_FROM_NAME="Metropolitan University"

CURRENCY=KES
CURRENCY_SYMBOL="KSh"

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
