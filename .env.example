APP_NAME="Best Brain University"
APP_SHORT_NAME="BBU"
APP_ENV=local
APP_DEBUG=true
APP_URL=
APP_TIMEZONE=Africa/Monrovia
# Reload the academic catalogue (database/seeds/catalog/bbiu.php) automatically after it changes.
CATALOG_AUTO_SYNC=true
APP_KEY=base64:CHANGE_THIS_TO_A_RANDOM_32_BYTE_STRING

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=university_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=ums_session
SESSION_LIFETIME=7200
SESSION_SECURE=false

MAIL_ENABLED=false
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@bestbrain.edu.lr
MAIL_FROM_NAME="Best Brain University"

# SMS alerts: log (default, sends nothing) | africastalking | twilio | http
SMS_DRIVER=log
SMS_SENDER=BBIU
SMS_COUNTRY_CODE=231
AT_USERNAME=
AT_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# For "http": e.g. https://gateway.example/send?to={to}&text={message}&from={sender}
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET

# MTN MoMo Collection API (online fee payments). Production: MOMO_BASE_URL=https://proxy.momoapi.mtn.com
# and MOMO_TARGET_ENV as given by MTN for Liberia (e.g. mtnliberia).
MOMO_ENABLED=false
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CURRENCY=USD
MOMO_COUNTRY_CODE=231

# Optional: full path to mysqldump for faster backups (otherwise PHP writes the backup).
MYSQLDUMP_PATH=

CURRENCY=USD
CURRENCY_SYMBOL="$"

MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=8
